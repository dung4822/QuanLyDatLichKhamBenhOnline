@backend_HostAddress = https://localhost:7023
@csrfToken = paste-requestToken-here
@email = patient@example.com
@password = replace-with-your-password

# Bật cookie jar trong HTTP client. Chạy csrf trước, copy requestToken vào biến csrfToken.
GET {{backend_HostAddress}}/api/auth/csrf
Accept: application/json

###

POST {{backend_HostAddress}}/api/auth/login
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

# Sau login, gọi lại csrf ở trên và cập nhật biến csrfToken.
GET {{backend_HostAddress}}/api/me/profile
Accept: application/json

###

POST {{backend_HostAddress}}/api/auth/logout
X-CSRF-TOKEN: {{csrfToken}}

###

GET {{backend_HostAddress}}/api/specialties
Accept: application/json

###

GET {{backend_HostAddress}}/api/specialties/1
Accept: application/json

###

POST {{backend_HostAddress}}/api/specialties
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "name": "Cardiology",
  "description": "Heart and cardiovascular specialty",
  "status": "Active"
}

###

PUT {{backend_HostAddress}}/api/specialties/1
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "name": "Dental",
  "description": "Dental examination and treatment",
  "status": "Active"
}

###

DELETE {{backend_HostAddress}}/api/specialties/1
Accept: application/json
X-CSRF-TOKEN: {{csrfToken}}

###
