# Copy thành deploy/.env trên server rồi điền giá trị thật:  cp .env.example .env && nano .env
# KHÔNG commit file .env.

# Tên miền đã trỏ về IP server (VD từ DuckDNS)
DOMAIN=ten-ban.duckdns.org

# Thư mục chứa repo frontend, tính từ thư mục deploy/
FRONTEND_DIR=../../frontend

# PostgreSQL chạy trong Docker (tự tạo lần đầu). Mật khẩu dài, chỉ chữ và số để khỏi phải escape.
POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=doi-mat-khau-nay

DEEPSEEK_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Chỉ dùng một lần để tạo tài khoản Admin đầu tiên, xong thì xóa giá trị.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
